# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated from data/jpn-kougo.osis.xml (npm run bible:convert)
/data/bible-paragraphs.json

# 出典の XML。再配布してよいか分からないので、リポジトリには入れない(npm run bible:fetch で取得する)
/data/jpn-kougo.osis.xml

# 評価(npm run eval:search)が保存する、書き換えの結果。比較を公平にするための一時ファイル
/.eval-cache/
